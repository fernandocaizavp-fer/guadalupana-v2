generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Rol {
  ADMIN
  PROFESOR
  ESTUDIANTE
}

model Usuario {
  id        Int      @id @default(autoincrement())
  nombre    String   @db.VarChar(100)
  apellido  String   @db.VarChar(100)
  correo    String   @unique @db.VarChar(100)
  cedula    String?  @unique @db.VarChar(10)
  password  String   @db.VarChar(60)
  rol       Rol      @default(ESTUDIANTE)
  activo    Boolean  @default(true)
  debeCambiarPassword Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  materiasComoProfesorPrincipal Materia[]  @relation("ProfesorPrincipalMateria")
  matricula                     Matricula?
  materias                      Materia[]
}

model Curso {
  id            Int      @id @default(autoincrement())
  ramaArtesanal String   @db.VarChar(50)
  anioFormativo String   @db.VarChar(10)
  fechaInicio   DateTime
  fechaFin      DateTime
  activo        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  materias                Materia[]
  matriculas              Matricula[]
  observacionesAsistencia ObservacionAsistencia[]
}

model Materia {
  id                  Int      @id @default(autoincrement())
  nombre              String   @db.VarChar(100)
  cursoId             Int
  curso               Curso    @relation(fields: [cursoId], references: [id], onDelete: Cascade)
  profesorId          Int?
  profesor            Usuario? @relation(fields: [profesorId], references: [id], onDelete: SetNull)
  esSubmateria        Boolean  @default(false)
  materiaParent       String?  @db.VarChar(100)
  profesorPrincipalId Int?
  profesorPrincipal   Usuario? @relation("ProfesorPrincipalMateria", fields: [profesorPrincipalId], references: [id])
  activo              Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  tareas          Tarea[]
  supletorios     Supletorio[]
  asistencias     Asistencia[]
  notasDisciplina NotaDisciplina[]
  examenesGrado   ExamenGrado[]
}

model Matricula {
  id                  Int      @id @default(autoincrement())
  matriculaNo         String   @db.VarChar(10)
  tomo                String?  @db.VarChar(5)
  pagina              String?  @db.VarChar(5)
  apellidos           String   @db.VarChar(100)
  nombres             String   @db.VarChar(100)
  cedula              String   @unique @db.VarChar(10)
  sexo                String?  @db.VarChar(20)
  nivelEstudio        String?  @db.VarChar(50)
  lugarfechamatricula String?  @db.VarChar(100)
  activo              Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  // Permiso individual y temporal para rendir supletorio fuera del plazo general
  // (caso de reclamo/oficio). Nullable: sin permiso si está en null.
  supletorioHabilitadoHasta DateTime?
  supletorioMotivo          String?   @db.VarChar(200)

  // Permiso individual y temporal para recalificar el examen de grado fuera del
  // plazo general (caso de reclamo/corrección). Nullable: sin permiso si está en null.
  examenGradoHabilitadoHasta DateTime?
  examenGradoMotivo          String?   @db.VarChar(200)

  cursoId   Int
  curso     Curso   @relation(fields: [cursoId], references: [id])
  usuarioId Int     @unique
  usuario   Usuario @relation(fields: [usuarioId], references: [id])

  datosPersonales DatosPersonalesMatricula?
  datosFamiliares DatosFamiliaresMatricula?
  datosAcademicos DatosAcademicosMatricula?

  notasTarea            NotaTarea[]
  supletorios           Supletorio[]
  asistenciaDetalles    AsistenciaDetalle[]
  notasDisciplina       NotaDisciplina[]
  examenesGrado         ExamenGrado[]
  observacionAsistencia ObservacionAsistencia?
  entregasTarea         EntregaTarea[]

  // NOTA: la unicidad de (cursoId, matriculaNo) NO se declara con @@unique
  // porque debe ser PARCIAL (solo entre matrículas activas), y Prisma no
  // soporta índices parciales en el schema. Se gestiona por SQL crudo en la
  // migración 'matricula_unica_activa_por_curso' con el índice
  // 'Matricula_cursoId_matriculaNo_activo_key' (WHERE activo = true). Esto
  // permite reutilizar el número de un estudiante archivado (activo=false).
}

model DatosPersonalesMatricula {
  id          Int       @id @default(autoincrement())
  matriculaId Int       @unique
  matricula   Matricula @relation(fields: [matriculaId], references: [id], onDelete: Cascade)

  fechaNacimiento DateTime?
  anioNacimiento  String?   @db.VarChar(4)
  mesNacimiento   String?   @db.VarChar(10)
  diaNacimiento   String?   @db.VarChar(2)
  pais            String?   @db.VarChar(30)
  provincia       String?   @db.VarChar(30)
  canton          String?   @db.VarChar(30)
  parroquia       String?   @db.VarChar(30)
  ciudad          String?   @db.VarChar(30)
  nacionalidad    String?   @db.VarChar(30)
  calle           String?   @db.VarChar(100)
  num             String?   @db.VarChar(10)
  transversal     String?   @db.VarChar(100)
  telefono        String?   @db.VarChar(15)
  correo          String?   @db.VarChar(100)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model DatosFamiliaresMatricula {
  id          Int       @id @default(autoincrement())
  matriculaId Int       @unique
  matricula   Matricula @relation(fields: [matriculaId], references: [id], onDelete: Cascade)

  nombrepapa             String? @db.VarChar(100)
  profesionpapa          String? @db.VarChar(60)
  ocupacionpapa          String? @db.VarChar(60)
  nombremama             String? @db.VarChar(100)
  profesionmama          String? @db.VarChar(60)
  ocupacionmama          String? @db.VarChar(60)
  nombrerepresentante    String? @db.VarChar(100)
  ocupacionrepresentante String? @db.VarChar(60)
  domiciliorepresentante String? @db.VarChar(150)
  telefonorepresentante  String? @db.VarChar(15)
  correoestudiante       String? @db.VarChar(100)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model DatosAcademicosMatricula {
  id          Int       @id @default(autoincrement())
  matriculaId Int       @unique
  matricula   Matricula @relation(fields: [matriculaId], references: [id], onDelete: Cascade)

  cursoanterior           String? @db.VarChar(100)
  unidadeducativa         String? @db.VarChar(100)
  centroformacionanterior String? @db.VarChar(100)
  tipoBachiller           String? @db.VarChar(60)
  conferidoPorA1          String? @db.VarChar(100)
  conferidoPorA2          String? @db.VarChar(100)
  especialidad            String? @db.VarChar(100)
  lugarfechacertificado   String? @db.VarChar(100)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Tarea {
  id          Int      @id @default(autoincrement())
  nombre      String   @db.VarChar(150)
  descripcion String?
  fecha       DateTime
  // Rango de la tarea: inicio y fecha límite de entrega. Nullable para no
  // romper tareas antiguas. `fecha` se mantiene (= fechaInicio) por compatibilidad
  // con los reportes AL14 y el ordenamiento existente.
  fechaInicio DateTime?
  fechaFin    DateTime?
  semestre    Int
  materiaId   Int
  materia     Materia  @relation(fields: [materiaId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  notas    NotaTarea[]
  archivos ArchivoTarea[]
  entregas EntregaTarea[]
}

model Supletorio {
  id          Int       @id @default(autoincrement())
  valor       Float?
  materiaId   Int
  materia     Materia   @relation(fields: [materiaId], references: [id], onDelete: Cascade)
  matriculaId Int
  matricula   Matricula @relation(fields: [matriculaId], references: [id], onDelete: Cascade)

  @@unique([materiaId, matriculaId])
}

model NotaTarea {
  id          Int       @id @default(autoincrement())
  valor       Float?
  observacion String?   @db.VarChar(200)
  tareaId     Int
  tarea       Tarea     @relation(fields: [tareaId], references: [id], onDelete: Cascade)
  matriculaId Int
  matricula   Matricula @relation(fields: [matriculaId], references: [id], onDelete: Cascade)

  @@unique([tareaId, matriculaId])
}

model Asistencia {
  id        Int      @id @default(autoincrement())
  fecha     DateTime
  materiaId Int
  materia   Materia  @relation(fields: [materiaId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  detalles AsistenciaDetalle[]
}

model AsistenciaDetalle {
  id           Int        @id @default(autoincrement())
  presente     Boolean    @default(true)
  asistenciaId Int
  asistencia   Asistencia @relation(fields: [asistenciaId], references: [id], onDelete: Cascade)
  matriculaId  Int
  matricula    Matricula  @relation(fields: [matriculaId], references: [id], onDelete: Cascade)

  @@unique([asistenciaId, matriculaId])
}

model ObservacionAsistencia {
  id          Int       @id @default(autoincrement())
  observacion String    @db.VarChar(300)
  matriculaId Int       @unique
  matricula   Matricula @relation(fields: [matriculaId], references: [id], onDelete: Cascade)
  cursoId     Int
  curso       Curso     @relation(fields: [cursoId], references: [id], onDelete: Cascade)
}

model Anuncio {
  id          Int      @id @default(autoincrement())
  titulo      String   @db.VarChar(150)
  contenido   String
  imagen      String?  @db.VarChar(200)
  activo      Boolean  @default(true)
  autorRol    Rol?
  autorNombre String?  @db.VarChar(200)
  // Dueño del anuncio: un PROFESOR solo puede editar/eliminar los suyos
  // (el ADMIN puede gestionar todos). Nulo en anuncios creados antes de este campo.
  autorId     Int?
  // Materia a la que se refiere el anuncio (etiqueta opcional, denormalizada).
  materiaNombre String? @db.VarChar(150)
  // Curso al que se dirige el anuncio. Null = general (lo ven todos). Con valor,
  // solo lo ven los estudiantes matriculados en ese curso.
  cursoId     Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model NotaDisciplina {
  id          Int       @id @default(autoincrement())
  valor       Float
  semestre    Int       @default(1)
  matriculaId Int
  materiaId   Int
  matricula   Matricula @relation(fields: [matriculaId], references: [id], onDelete: Cascade)
  materia     Materia   @relation(fields: [materiaId], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([matriculaId, materiaId, semestre])
}

model ExamenGrado {
  id          Int       @id @default(autoincrement())
  valor       Float?
  materiaId   Int
  matriculaId Int
  materia     Materia   @relation(fields: [materiaId], references: [id], onDelete: Cascade)
  matricula   Matricula @relation(fields: [matriculaId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([materiaId, matriculaId])
}

model RecuperacionPassword {
  id        Int      @id @default(autoincrement())
  correo    String
  codigo    String
  expira    DateTime
  usado     Boolean  @default(false)
  createdAt DateTime @default(now())
}

// Configuración global del sistema (fila única, id = 1).
// Todos los campos tienen valor por defecto para no alterar el comportamiento
// actual si el administrador nunca la edita.
model Configuracion {
  id                   Int       @id @default(1)
  // CAMBIO 1 — control de supletorios por el administrador
  supletorioHabilitado Boolean   @default(false)
  supletorioInicio     DateTime?
  supletorioFin        DateTime?
  // Plazo general de exámenes de grado (controlado por el administrador)
  examenGradoInicio    DateTime?
  examenGradoFin       DateTime?
  // CAMBIO 2 — rango de notas configurable
  notaMinima           Float     @default(0)
  notaMaxima           Float     @default(10)
  notaAprobacion       Float     @default(7)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
}

// Archivos que el docente adjunta a una tarea (almacenados en Cloudinary).
model ArchivoTarea {
  id             Int      @id @default(autoincrement())
  url            String   @db.VarChar(500)
  publicId       String   @db.VarChar(255)
  resourceType   String?  @db.VarChar(20)
  nombreOriginal String   @db.VarChar(255)
  tipo           String?  @db.VarChar(120)
  tamano         Int?
  tareaId        Int
  tarea          Tarea    @relation(fields: [tareaId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now())
}

// Entrega de un estudiante para una tarea (cabecera). Una por tarea+matrícula.
model EntregaTarea {
  id          Int              @id @default(autoincrement())
  comentario  String?          @db.VarChar(500)
  tareaId     Int
  tarea       Tarea            @relation(fields: [tareaId], references: [id], onDelete: Cascade)
  matriculaId Int
  matricula   Matricula        @relation(fields: [matriculaId], references: [id], onDelete: Cascade)
  archivos    ArchivoEntrega[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@unique([tareaId, matriculaId])
}

// Archivos de una entrega del estudiante (almacenados en Cloudinary).
model ArchivoEntrega {
  id             Int          @id @default(autoincrement())
  url            String       @db.VarChar(500)
  publicId       String       @db.VarChar(255)
  resourceType   String?      @db.VarChar(20)
  nombreOriginal String       @db.VarChar(255)
  tipo           String?      @db.VarChar(120)
  tamano         Int?
  entregaId      Int
  entrega        EntregaTarea @relation(fields: [entregaId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())
}